# 範本：複製成 .env 後填入本機值（.env 不進版控，此範本會）
# cp .env.example .env

# --- 本機 docker-compose 的 Postgres ---
POSTGRES_DB=survey
POSTGRES_USER=survey_app
POSTGRES_PASSWORD=change_me

# --- 後端連 DB（application.yaml 會吃這些覆蓋預設）---
DB_URL=jdbc:postgresql://localhost:5432/survey
DB_USER=survey_app
DB_PASSWORD=change_me

# --- 其餘可覆蓋項（本機通常用預設即可；正式環境在 ACA 設）---
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173,http://localhost:8080
# SWAGGER_ENABLED=true
#
# 正式環境（Azure Container Apps）的值改在 ACA 環境變數 / secret 設，例如：
#   DB_URL=jdbc:postgresql://<mac-mini-tailscale-host>:5432/survey
#   DB_PASSWORD=<secret>
#   APP_CORS_ALLOWED_ORIGINS=https://你的前端網域
#   SWAGGER_ENABLED=false
# 詳見 repo 根目錄 DEPLOY.md。
